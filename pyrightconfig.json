{
  "typeCheckingMode": "strict",
  "useLibraryCodeForTypes": true,
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    ".venv",
    "**/__pycache__",
    "**/node_modules",
    "**/.*",
    "notebooks"
  ],
  "executionEnvironments": [
    {
      "root": "tests",
      "extraPaths": [
        "./src"
      ],
      "reportPrivateUsage": false
    },
    {
      "root": ".",
      "extraPaths": [
        "./src"
      ]
    }
  ]
}