{
  "typeCheckingMode": "strict",
  "useLibraryCodeForTypes": true,
  "include": ["src", "tests"],
	"exclude": [
		".venv",
		"**/__pycache__",
		"**/node_modules",
		"**/.*",
    "nb"
	],
  "executionEnvironments": [
    {
      "root": "tests",
      "extraPaths": ["./src"],
      "reportUnknownMemberType": false,
      "reportPrivateUsage": false
    },
    {
      "root": ".",
      "extraPaths": ["./src"]
    }
  ]
}
